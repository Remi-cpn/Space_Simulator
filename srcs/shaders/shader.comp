#version 430

#define GOLDEN_NBR_X 0.754877666
#define GOLDEN_NBR_Y 0.569840296

layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform image2D outImg;
uniform sampler2D skybox;

// Camera
uniform vec3 	cam_origin;
uniform vec3 	cam_corner;
uniform vec3 	cam_hor;
uniform vec3 	cam_ver;

// Black Hole
uniform float	bh_mass;
uniform vec3	bh_pos;	// position du trou noir
uniform int		steps;	// nombre de pas RK4
uniform float	step_size;	// h

// Rayon par pixels
uniform int		nbr_ray;

// Rendu viseul
uniform float exposure;
uniform float gamma;

// Structure Objects respectant le padding de 16bits
// Un soleil est geometriquement une sphere -> pas de structure separee,
// juste "emissive" pour savoir plus tard si on lui applique l'eclairage
// (comme hit.hit == 2 en miniRT, mais porte directement dans la donnee).
struct t_gpu_sphere
{
	vec3	center;
	float	radius;
	vec4	color;
	int		emissive;
	float	pad0;
	float	pad1;
	float	pad2;
};

layout(std430, binding = 1) readonly buffer SphereBuffer
{
	t_gpu_sphere	spheres[];
};

struct t_gpu_ring
{
	vec3	center;
	float	inner_rad;
	vec3	normal;
	float	outer_rad;
	vec4	color;
};

layout(std430, binding = 2) readonly buffer RingBuffer
{
	t_gpu_ring	ring[];
};

/* ——— choix du pixel sur le skybox —————————————————————————————————————————————————————————— */

vec4 sample_skybox(vec3 direction)
{
	float lon = atan(direction.z, direction.x);
	float lat = asin(direction.y);
	vec2 sky_uv = vec2(lon / (2.0 * 3.14159265) + 0.5, lat / 3.14159265 + 0.5);
	return texture(skybox, sky_uv);
}

/* ——— Calcul d'intercection ——————————————————————————————————————————————————————————————— */
bool hit_sphere(vec3 ray_origin, vec3 ray_dir, t_gpu_sphere sph, out float t)
{
	vec3 oc = ray_origin - sph.center;
	float a = dot(ray_dir, ray_dir);
	float b = dot(ray_dir, oc);
	float c = dot(oc, oc) - sph.radius * sph.radius;
	float disc = b * b - a * c;
	if (disc < 0.0)
		return false;
	t = (-b - sqrt(disc)) / a;
	// Vu qu'on test un segment et pas un ray infinie je rajoute t > 1.0
	if (t < 0.0001 || t > 1.0)
		t = (-b + sqrt(disc)) / a;
	if (t < 0.001 || t > 1.0)
		return false;
	return (true);
}

bool hit_ring(vec3 ray_origin, vec3 ray_dir, t_gpu_ring rg, out float t)
{
	float dir = dot(ray_dir, rg.normal);
	if (abs(dir) < 0.0001)
		return false;
	t = dot(rg.center - ray_origin, rg.normal) / dir;
	if (t < 0.0 || t > 1.0)
		return false;
	vec3 hit = ray_origin + t * ray_dir;
	float diff = length(hit - rg.center);
	return (diff >= rg.inner_rad && diff <= rg.outer_rad);
}

bool test_segment_objects(vec3 ray_origin, vec3 p1, out vec4 hit_color)
{
	vec3 ray_dir = p1 - ray_origin;
	float best_t = 2.0; // > 1.0, donc "rien trouve" au depart
	bool hit = false;
	float t;

	for (int i = 0; i < spheres.length(); i++)
		if (hit_sphere(ray_origin, ray_dir, spheres[i], t) && t < best_t)
		{
			best_t = t;
			hit_color = spheres[i].color;
			hit = true;
		}
	for (int i = 0; i < ring.length(); i++)
		if (hit_ring(ray_origin, ray_dir, ring[i], t) && t < best_t)
		{
			best_t = t;
			hit_color = ring[i].color;
			hit = true;
		}
	return hit;
}


/* ——— Calcul de la trajectoire d'un photon ———————————————————————————————————————————————— */
/* Intégration directe en 3D (position + vitesse), pas de réduction 2D/reconstruction —
   approche "starless" (rantonels/starless), évite toute construction de base (e1/e2)
   et donc toute singularité de type produit vectoriel proche de zéro. */

struct t_state
{
	vec3	pos;
	vec3	vel;
};

t_state add_state(t_state a, t_state b)
{
	t_state	r;

	r.pos = a.pos + b.pos;
	r.vel = a.vel + b.vel;
	return (r);
}

t_state scale_state(t_state a, float s)
{
	t_state	r;

	r.pos = a.pos * s;
	r.vel = a.vel * s;
	return (r);
}

// F(r) = -3M h² / r⁴ (forme vectorielle de l'équation de Binet)
t_state orbit_derivative(t_state s, float h2, float M)
{
	t_state	d;
	float	r2;

	d.pos = s.vel;
	r2 = dot(s.pos, s.pos);
	d.vel = -3.0 * M * h2 * s.pos / (r2 * r2 * sqrt(r2)); // r^5 = r2² * √r2
	return (d);
}

// Calcul de RK4
t_state rk4_step(t_state s, float h2, float M, float h)
{
	t_state	k1;
	t_state	k2;
	t_state	k3;
	t_state	k4;
	t_state	sum;

	k1 = orbit_derivative(s, h2, M);
	k2 = orbit_derivative(add_state(s, scale_state(k1, 0.5 * h)), h2, M);
	k3 = orbit_derivative(add_state(s, scale_state(k2, 0.5 * h)), h2, M);
	k4 = orbit_derivative(add_state(s, scale_state(k3, h)), h2, M);
	sum = add_state(add_state(k1, scale_state(k2, 2.0)),
			add_state(scale_state(k3, 2.0), k4));
	return (add_state(s, scale_state(sum, h / 6.0)));
}

vec4 photon_trajectory(vec3 dir)
{
	t_state	s;
	vec3	hvec;
	float	h2;
	float	rs;
	float	r_max;
	float	r;

	s.pos = cam_origin - bh_pos;
	s.vel = dir;

	hvec = cross(s.pos, s.vel);
	h2 = dot(hvec, hvec); // moment angulaire² conservé

	rs = 2.0 * bh_mass;

	// distance d'evasion : toujours r0 + une marge fixe, jamais un multiple de r0
	// (sinon la distance a parcourir explose avec r0 et la perf s'effondre au loin)
	r_max = length(s.pos) + 50.0 * rs;

	for (int i = 0; i < steps; i++)
	{
		r = length(s.pos);
		vec3 pos_prev = s.pos;
		s = rk4_step(s, h2, bh_mass, step_size * clamp(r / rs, 0.1, 200.0));
		r = length(s.pos);

		// Objets testes en coordonnees absolues (celles du .ss), donc on
		// retranslate le segment (relatif au trou noir) en espace monde.
		vec4 obj_color;
		if (test_segment_objects(pos_prev + bh_pos, s.pos + bh_pos, obj_color))
			return obj_color;

		if (r < rs)
		{
			// Horizon franchi -> noir
			return vec4 (0, 0, 0, 1);
		}
		if (r > r_max)
		{
			// Évasion -> échantillonner le skybox avec la vitesse finale
			return sample_skybox(normalize(s.vel));
		}
	}
	// Si on arrive ici sans être sorti : budget de pas épuisé
	return vec4 (0, 0, 0, 1);
}



/* ——— Main —————————————————————————————————————————————————————————— */

void main()
{
	ivec2	pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2	size  = imageSize(outImg);

	if (pixel.x >= size.x || pixel.y >= size.y || size.x == 0 || size.y == 0)
		return;

	// Boucle d'envoi de rayon par pixel
	vec4	color = vec4(0, 0, 0, 0);
	vec2	inv_size = 1.0 / vec2(size);
	for (int i = 0; i < nbr_ray; i++)
	{
		vec2	offset = fract(vec2(i) * vec2(GOLDEN_NBR_X, GOLDEN_NBR_Y));
		vec2	uv = (vec2(pixel) + offset) * inv_size;
		vec3	dir = normalize(cam_corner + uv.x * cam_hor + uv.y * cam_ver - cam_origin);
		color += photon_trajectory(dir);
	}

	color = color / nbr_ray;
	color.rgb = pow(color.rgb * exposure, vec3(1.0 / gamma));
	imageStore(outImg, pixel, color);
}