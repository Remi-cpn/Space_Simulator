#version 430
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform image2D outImg;
uniform sampler2D skybox;

//Camera
uniform vec3 	cam_origin;
uniform vec3 	cam_corner;
uniform vec3 	cam_hor;
uniform vec3 	cam_ver;

// Black Hole
uniform float	bh_mass;
uniform vec3	bh_pos;	// position du trou noir
uniform int		steps;	// nombre de pas RK4
uniform float	step_size;	// h


/* ——— choix du pixel sur le skybox —————————————————————————————————————————————————————————— */

vec4 sample_skybox(vec3 direction)
{
	float lon = atan(direction.z, direction.x);
	float lat = asin(direction.y);
	vec2 sky_uv = vec2(lon / (2.0 * 3.14159265) + 0.5, lat / 3.14159265 + 0.5);
	return texture(skybox, sky_uv);
}


/* ——— Calcul de la trajectoire d'un photon —————————————————————————————————————————————————————————— */

// L'équation de Binet
vec2 orbit_derivative(vec2 state, float M)
{
    float u = state.x;
    float v = state.y;
    return vec2(v, 3.0 * M * u * u - u); // dv/dφ = 3Mu² - u
}

// Calcul de RK4
vec2 rk4_step(vec2 state, float M, float h)
{
    vec2 k1 = orbit_derivative(state, M);
	vec2 k2 = orbit_derivative(state + 0.5 * h * k1, M);
	vec2 k3 = orbit_derivative(state + 0.5 * h * k2, M);
	vec2 k4 = orbit_derivative(state + h * k3, M);
	return (state + (h / 6.0) * (k1 + 2 * k2 + 2 * k3 + k4));
}

vec4 photon_trajectory(vec3 dir)
{
	vec3 P = cam_origin - bh_pos;
	float r0 = length(P);
	vec3 e1 = normalize(P);
	vec3 n = normalize(cross(P, dir));
	vec3 e2 = cross(n, e1);
	float b = length(cross(P, dir));
	float u0 = 1.0 / r0;

	// (du/dφ)² = 1/b² - u² + 2Mu³
	float du0_sq = 1.0/(b*b) - u0*u0 + 2.0*bh_mass*u0*u0*u0;
	float du0 = sqrt(max(du0_sq, 0.0)) * -sign(dot(dir, e1));

	vec2 state = vec2(u0, du0);
	float phi = 0.0;
	float rs = 2.0 * bh_mass;

	// distance d'affichage en dur !!
	float r_max = 500.0 * rs;

	for (int i = 0; i < steps; i++)
	{
		state = rk4_step(state, bh_mass, step_size);
		phi += step_size;

		float r = 1.0 / state.x;

		if (r < rs)
		{
			// Horizon franchi -> noir
			return vec4 (0, 0, 0, 1);
		}
		if (r > r_max)
		{
			// Évasion -> reconstruire la direction finale, échantillonner le skybox
			vec3 final_dir = normalize(cos(phi) * e1 + sin(phi) * e2);
			return sample_skybox(final_dir);
		}
	}
	// Si on arrive ici sans être sorti : budget de pas épuisé
	return vec4 (0, 0, 0, 1);
}



/* ——— Main —————————————————————————————————————————————————————————— */

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size  = imageSize(outImg);

	if (pixel.x >= size.x || pixel.y >= size.y || size.x == 0 || size.y == 0)
		return;

	vec2 uv = vec2(pixel) / vec2(size);
	vec3 dir = normalize(cam_corner + uv.x * cam_hor + uv.y * cam_ver - cam_origin);
	vec4 color = photon_trajectory(dir);


	imageStore(outImg, pixel, color);
}